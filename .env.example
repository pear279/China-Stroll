VITE_SUPABASE_URL=https://yjguudzllzjdmqsgwtru.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
VITE_API_BASE_URL=http://localhost:8787
VITE_ENABLE_TEST_LOGIN=true

# Set these as Worker secrets. Never expose them through VITE variables.
SUPABASE_URL=https://yjguudzllzjdmqsgwtru.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
WEB_ORIGIN=http://localhost:5173

# Published place reads go through row level security instead of the service role.
# This is the same publishable key the browser uses, so it is not a secret.
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# SiliconFlow secrets stay on the server. Model identifiers can be overridden when needed.
SILICONFLOW_API_KEY=replace-with-siliconflow-api-key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICONFLOW_EMBEDDING_MODEL=BAAI/bge-m3
SILICONFLOW_TIMEOUT_MS=15000
