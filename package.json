{
  "name": "china-stroll",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm-run-all --parallel dev:web dev:worker",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:worker": "wrangler dev --config apps/worker/wrangler.jsonc",
    "dev:pages": "npm run build:web && wrangler pages dev dist/web --compatibility-date=2026-08-27 --compatibility-flags=nodejs_compat",
    "build": "npm run typecheck && npm run lint && npm run test && npm run build:web && npm run build:functions && npm run build:worker",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "build:functions": "wrangler pages functions build functions --outdir dist/pages-functions --project-directory . --compatibility-date=2026-08-27 --compatibility-flags=nodejs_compat",
    "build:worker": "wrangler deploy --dry-run --config apps/worker/wrangler.jsonc --outdir ../../dist/worker",
    "db:verify": "bash scripts/verify-local-database.sh",
    "typecheck": "tsc -p apps/web/tsconfig.json --noEmit && tsc -p apps/worker/tsconfig.json --noEmit",
    "lint": "oxlint apps/worker/src functions apps/web/src packages/shared/src",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.4",
    "hono": "4.13.5",
    "lucide-react": "1.34.0",
    "maplibre-gl": "6.6.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.6",
    "@types/geojson": "^7946.0.16",
    "@types/node": "24.10.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "happy-dom": "20.11.8",
    "npm-run-all": "4.1.5",
    "oxlint": "1.80.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "^4.127.0"
  }
}
