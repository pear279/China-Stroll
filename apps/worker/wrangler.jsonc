{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "china-stroll-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-27",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "logs": { "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.05 }
  },
  "vars": {
    "SUPABASE_URL": "https://yjguudzllzjdmqsgwtru.supabase.co",
    "SUPABASE_PUBLISHABLE_KEY": "",
    "WEB_ORIGIN": "http://localhost:5173",
    "SILICONFLOW_BASE_URL": "https://api.siliconflow.cn/v1",
    "SILICONFLOW_CHAT_MODEL": "deepseek-ai/DeepSeek-V4-Flash",
    "SILICONFLOW_EMBEDDING_MODEL": "BAAI/bge-m3",
    "SILICONFLOW_TIMEOUT_MS": "15000",
    "ALLOW_ANONYMOUS_PLACE_AI": "true"
  },
  "ratelimits": [{
    "name": "PLACE_AI_RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 10, "period": 60 }
  }]
}
